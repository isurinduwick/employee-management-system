{
  "openapi": "3.0.1",
  "info": {
    "title": "Employee Management System API",
    "description": "REST API backing the Employee Management System's web and mobile clients, covering three modules: employee & identity (employee/department records and JWT login with Admin/Manager/Employee roles), attendance (self-service daily check-in/check-out and history), and leave (leave requests and the Manager/Admin approval workflow).",
    "version": "v1"
  },
  "paths": {
    "/api/attendance/check-in": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Checks the authenticated employee in for today.",
        "description": "Any authenticated role. Always acts on the caller's own id (from the JWT) — there is no\r\nway to check someone else in. `DeviceType` records where the check-in came from\r\n(`Web` or `Mobile`). Only one check-in per employee per calendar day is allowed;\r\na second attempt returns 409.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/attendance/check-out": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Checks the authenticated employee out for today.",
        "description": "Any authenticated role. Takes no request body — it closes the caller's own currently-open\r\nattendance record for today (the row created by check-in), rather than creating a new one.\r\nReturns 400 if the caller hasn't checked in today, and 409 if they've already checked out.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/attendance": {
      "get": {
        "tags": [
          "Attendance"
        ],
        "summary": "Lists attendance records, optionally filtered by employee, department, and date range.",
        "description": "Role-scoped visibility: an `Employee` always sees only their own records — the\r\nemployeeId and departmentId filters are silently\r\nignored for that role rather than honoured, since the caller could otherwise pass anyone's\r\nid. `Manager`/`Admin` may filter freely across the whole company.\r\nstartDate/endDate are inclusive on both ends and\r\napply to every role.",
        "parameters": [
          {
            "name": "employeeId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "departmentId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AttendanceResponseDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logs in with an email and password and returns a JWT.",
        "description": "Anonymous — no token required to call this endpoint. The returned token must be sent as\r\n`Authorization: Bearer <token>` on every other request. Deactivated accounts\r\n(`IsActive = false`) are rejected the same as a wrong password.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
