    "/api/leave-requests": {
      "post": {
        "tags": [
          "LeaveRequests"
        ],
        "summary": "Submits a new leave request for the authenticated employee.",
        "description": "Any authenticated role. Always created for the caller's own id (from the JWT) and always\r\nstarts as `Pending` — only the decision endpoint can move it to\r\n`Approved`/`Rejected`. Returns 400 if `EndDate` is before `StartDate`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaveRequestCreateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaveRequestCreateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LeaveRequestCreateDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaveResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
