{
  // Real values for ConnectionStrings:DefaultConnection and Jwt:Key are not
  // committed here. Locally they come from `dotnet user-secrets` (see
  // README.md); in production, from environment variables
  // (ConnectionStrings__DefaultConnection, Jwt__Key).
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "",
    "Issuer": "EmsApi",
    "Audience": "EmsClient",
    "ExpiryMinutes": 60
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5174", "http://localhost:5175", "http://localhost:3000" ]
  }
}
